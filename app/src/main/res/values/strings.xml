<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">FingerLock</string>

    <string name="accessibility_service_label">FingerLock アプリロック</string>
    <string name="accessibility_service_description">ロック対象のアプリが前面に表示されたことを検知するために使用します。画面の内容は読み取りません。</string>

    <!-- セットアップ -->
    <string name="setup_title">セットアップ</string>
    <string name="setup_description">アプリロックを有効にするには、以下の2つの許可が必要です。</string>
    <string name="setup_overlay_title">1. 他のアプリの上に表示</string>
    <string name="setup_overlay_description">対象アプリの起動時にロック画面を最前面に表示するために必要です。</string>
    <string name="setup_accessibility_title">2. ユーザー補助サービス</string>
    <string name="setup_accessibility_description">対象アプリが前面に来たことを検知するために必要です。「インストール済みアプリ」から FingerLock を選んでONにしてください。</string>
    <string name="setup_notification_title">3. 通知(任意)</string>
    <string name="setup_notification_description">ロック解除の連続失敗を通知でお知らせします。未許可でもロック機能は動作します(失敗履歴はアプリ内に記録されます)。</string>
    <string name="setup_granted">許可済み</string>
    <string name="setup_open_settings">設定を開く</string>
    <string name="setup_request_permission">許可する</string>

    <!-- アプリ一覧 -->
    <string name="app_list_search_hint">アプリを検索</string>
    <string name="app_list_locked_count">%1$d 個のアプリをロック中</string>
    <string name="app_list_filter_locked">ロック中のみ</string>
    <string name="open_settings">設定</string>
    <string name="open_history">失敗履歴</string>

    <!-- 設定 -->
    <string name="settings_title">設定</string>
    <string name="settings_back">戻る</string>
    <string name="settings_grace_title">再ロックまでの猶予</string>
    <string name="settings_grace_description">対象アプリを離れてからこの時間内に戻れば、再認証は不要です。</string>
    <string name="settings_grace_immediate">即時(離れたらすぐ再ロック)</string>
    <string name="settings_grace_30s">30秒</string>
    <string name="settings_grace_1m">1分</string>
    <string name="settings_grace_5m">5分</string>
    <string name="settings_screen_off_title">画面OFFで再ロック</string>
    <string name="settings_screen_off_description">画面を消灯したら、すべてのアプリのロックを解除前の状態に戻します。</string>
    <string name="settings_failure_threshold_title">失敗アラートの閾値</string>
    <string name="settings_failure_threshold_description">1回のロック画面で生体認証にこの回数失敗すると、通知と履歴記録を行います。PIN・パターン入力での失敗は検知できません。</string>
    <string name="settings_failure_threshold_times">%1$d 回</string>
    <string name="settings_dismiss_mode_title">認証せず閉じた場合の扱い</string>
    <string name="settings_dismiss_mode_description">認証プロンプトを認証せずに閉じる操作(キャンセル)の扱いを選びます。検知・記録する場合、同一アプリの連続キャンセルは5分間隔に間引かれます。</string>
    <string name="settings_dismiss_mode_alert">失敗と同様に検知する(通知・撮影・履歴)</string>
    <string name="settings_dismiss_mode_log_only">履歴にのみ残す(通知・撮影なし)</string>
    <string name="settings_dismiss_mode_off">記録しない</string>
    <string name="settings_intruder_photo_title">失敗時にインカメラで撮影</string>
    <string name="settings_intruder_photo_description">失敗アラートの発生時に、インカメラでプレビューなしの写真を1枚撮影し、通知と失敗履歴に残します。ロック解除を試みた人が無断で撮影される点に注意してください。写真は端末内(アプリ専用領域)にのみ保存され、最大20枚を超えると古い順に削除されます。端末によってはシャッター音が鳴ります。</string>
    <string name="settings_intruder_photo_denied">カメラの権限がないため有効にできません。システムの設定アプリから許可してください。</string>

    <!-- ロック画面 -->
    <string name="lock_prompt_title">%1$s のロック解除</string>
    <string name="lock_prompt_subtitle">続行するには認証してください</string>
    <string name="lock_unlock_button">ロック解除</string>
    <string name="lock_go_home_button">ホームに戻る</string>
    <string name="lock_close_button">閉じる</string>
    <string name="lock_locked_out">認証に失敗しすぎたため、一時的にロックされています</string>

    <!-- 失敗アラート通知 -->
    <string name="notification_channel_name">セキュリティアラート</string>
    <string name="notification_failure_title">%1$s のロック解除に連続失敗</string>
    <string name="notification_failure_text">%2$s に %1$d 回失敗しました</string>
    <string name="notification_dismissed_title">%1$s のロック解除が中断されました</string>
    <string name="notification_dismissed_text">%1$s に認証せずプロンプトが閉じられました</string>

    <!-- 失敗履歴 -->
    <string name="history_title">失敗履歴</string>
    <string name="history_empty">失敗の記録はありません</string>
    <string name="history_failure_count">%1$d 回失敗</string>
    <string name="history_dismissed">認証せず閉じた</string>
    <string name="history_photo_description">撮影された写真</string>
    <string name="history_photo_close">閉じる</string>
</resources>
